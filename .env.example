# Copy to .env.local and fill in real values there. Never commit .env.local
# or any file containing real keys/URLs/emails.

# --- Google Sheets (server-only; read-only spreadsheets.readonly scope) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@example-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=placeholder-spreadsheet-id

# --- Supabase Auth (public config — the publishable key is meant to be
# shipped to the browser; access is enforced by Supabase Row Level
# Security, not by keeping this secret). Used by the browser client, the
# server client, and proxy.ts alike — no service-role/secret key is used
# anywhere in this codebase. ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder-publishable-key

# --- Web Push / VAPID (server-only private key + subject; the public key
# is meant to be shipped to the browser, same NEXT_PUBLIC_* convention as
# Supabase's own public config above). Generate real values with:
#   npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY must never be exposed to the browser, logged, or
# committed. Missing/placeholder values fail gracefully at runtime (only
# the notification enable/send actions are affected) — the app still
# builds and runs without them configured. ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=placeholder-vapid-public-key
VAPID_PRIVATE_KEY=placeholder-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# --- PR #30: automatic notification engine (server-only) ---
#
# SUPABASE_SERVICE_ROLE_KEY: the ONE exception to "no service-role key
# anywhere in this codebase" (see src/lib/supabase/serviceRoleClient.ts's
# own docstring for why the notification worker genuinely needs it — it
# runs on a Supabase Cron trigger with no logged-in user/session, so no
# RLS-scoped client can resolve recipients or write internal engine
# state). Also used by the personal calendar feed's token -> owner lookup
# (src/lib/calendar/feedOwnerLookup.ts) for the same structural reason: an
# external calendar client fetching /calendar/<token>.ics carries no
# Supabase session either. Get this from Supabase Dashboard -> Project
# Settings -> API -> service_role secret. NEVER expose this to the
# browser, NEVER log it, NEVER commit it, and never reuse it for anything
# an RLS-scoped client could do instead.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key
#
# NOTIFICATION_WORKER_SECRET: a strong random shared secret Supabase Cron
# sends as `Authorization: Bearer <secret>` when calling
# POST /internal/notifications/tick (every 5 minutes) AND
# POST /internal/notifications/scheduled (every minute, the dedicated
# scheduled-broadcast worker -- same secret, same trust boundary, never a
# second one). Generate with e.g.
#   openssl rand -base64 32
# NEVER expose this to the browser, NEVER log it, NEVER commit it.
#
# This secret is ALSO the root of the delivery-receipt token key (see
# src/lib/notifications/receiptToken.ts). The receipt key is derived from
# it through a fixed domain-separation label rather than used directly,
# so the two key spaces are cryptographically unrelated -- a leaked
# receipt token can never be replayed as worker authorization. No extra
# environment variable is needed for receipts, and a deployment without
# this secret simply sends no receipt tokens (delivery itself is
# unaffected). Rotating it invalidates any receipt token still in
# flight, which at worst loses one `received_at` timestamp.
NOTIFICATION_WORKER_SECRET=placeholder-worker-secret

# --- TAKSHAL CTRL delivery channel (server-only; optional, additive) ---
#
# Lets the notification worker ALSO deliver a notification through the
# TAKSHAL CTRL notification hub, next to (never instead of) this app's own
# Web Push + inbox. See src/lib/notifications/takshal/README.md. Every
# variable is a plain server env var: NEVER prefix any of them with
# NEXT_PUBLIC_ (that would ship them to the browser). Leaving them unset
# keeps every notification on the existing direct delivery only.
#
# TAKSHAL_CTRL_HUB_URL: the hub's origin (no path). Production:
#   https://takshal-ctrl.vercel.app
# No default -- unset means the channel is off.
TAKSHAL_CTRL_HUB_URL=
#
# TAKSHAL_CTRL_SOURCE_SECRET: the shared source credential. The SAME value
# must be set as MACHLAVA_SOURCE_SECRET in the TAKSHAL CTRL project.
# Generate once with `openssl rand -hex 32`. Secret: NEVER expose it to the
# browser, NEVER log it, NEVER commit it.
TAKSHAL_CTRL_SOURCE_SECRET=
#
# TAKSHAL_CTRL_TEST_RECIPIENTS: temporary rollout allowlist -- comma-
# separated VERIFIED emails (the Google account's address) that receive
# BOTH channels. Empty/unset = everyone stays direct-only. Server-only
# configuration; never commit a real address here.
TAKSHAL_CTRL_TEST_RECIPIENTS=
